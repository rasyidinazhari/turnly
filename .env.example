# ─── Foundry / Deploy ────────────────────────────────────────────────
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONAD_MAINNET_RPC=https://rpc.monad.xyz
DEPLOYER_ACCOUNT=monad-deployer
# MIN_PERIOD_SECONDS=60   # default 60 untuk demo, 86400 untuk produksi

# ─── Frontend (NEXT_PUBLIC_* di-embed saat build) ────────────────────
NEXT_PUBLIC_CHAIN_ID=10143
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_EXPLORER_URL=https://testnet.monadvision.com
NEXT_PUBLIC_ARISAN_POOL=0x...   # isi setelah deploy
NEXT_PUBLIC_MOCK_IDRX=0x...     # isi setelah deploy
NEXT_PUBLIC_PRIVY_APP_ID=...    # dari dashboard privy.io

# ─── Server only (jangan awali NEXT_PUBLIC_) ─────────────────────────
PRIVY_APP_SECRET=...            # dari dashboard privy.io
DATABASE_URL=postgresql://...   # dari Neon atau Supabase
